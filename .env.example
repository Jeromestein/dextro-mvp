# Server-side key for story and image generation. Never use NEXT_PUBLIC_.
# Manual authoring, sample stories and CC0 music work without a key.
OPENAI_API_KEY=

# Optional default models; authors can choose models in Settings.
OPENAI_MODEL=gpt-5.6-luna
OPENAI_IMAGE_MODEL=gpt-image-2.5-flare

# Storage defaults to browser-local. Set supabase for the private internal workspace.
# Internal cloud mode currently works on localhost in development only.
STORAGE_MODE=local
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Must match an app_users record. Never accept this value from a browser request.
INTERNAL_TEST_OWNER_ID=
# Global paid-attempt cap per UTC day, including story repairs (hard maximum 100).
GENERATION_DAILY_LIMIT=20
