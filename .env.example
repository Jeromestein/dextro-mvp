# Optional. Manual authoring, sample stories and exports work without AI.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
# Required for API-key generation only; local ChatGPT sign-in needs no code.
AI_ACCESS_CODE=

# api (default): separately billed API key; chatgpt: local plan authorization.
# ChatGPT mode supports localhost and 127.0.0.1 in development, never Vercel.
# Keep the server listening on 127.0.0.1 for the required OAuth callback.
AI_PROVIDER=api
